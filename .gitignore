# build output (build/, build-perf/, build-gpu/, ... )
build*/

# python
__pycache__/
*.pyc
.venv/

# run artifacts: written by tools/bench/bench_compare.py, regenerable
/benchmark-results/
/tools/benchmark-results/

# bisection data: 218 MB of raw float32, regenerated by tools/dump_ref_activations.py,
# tools/dump_image_fixture.py and tools/dump_audio_fixture.py (needs the checkpoint)
tests/ref_act/

# exported int8 model cache (916 MB, E2_Q8_WRITE)
*.e8cq

*.log

# local documentation corpus (design notes, review, GPU investigation, benchmark methods and
# results). Kept in the working tree, deliberately not published.
/docs/llms/

# model checkpoints (./download_model.sh)
/models/
